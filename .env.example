# =====================================================================
# VYRA — environment configuration template
# Copy this file to `.env` and fill in the values you need.
# NEVER commit a real `.env` file. It is ignored by git.
# =====================================================================

# ---------------------------------------------------------------------
# AI provider selection
# VYRA runs on Google's Gemini API. The live default model is
# gemini-3-flash-preview. You normally never edit this file by hand —
# the first-run setup screen asks for your Gemini API key and stores it
# securely in the app's data directory.
# ---------------------------------------------------------------------
VYRA_AI_PROVIDER=google
VYRA_AI_MODEL=gemini-3-flash-preview

# Get a free key at https://aistudio.google.com (Google AI Studio).
GOOGLE_GENERATIVE_AI_KEY=
# Optional overrides (advanced): set VYRA_AI_PROVIDER to one of
# openai | anthropic | google | ollama and fill in the matching key.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# For local models (Ollama must be running separately)
OLLAMA_BASE_URL=http://localhost:11434

# ---------------------------------------------------------------------
# Speech-to-text (STT) provider
# One of: openai-whisper | deepgram | azure | system
# ---------------------------------------------------------------------
VYRA_STT_PROVIDER=openai-whisper
# Reuses OPENAI_API_KEY when set; otherwise:
DEEPGRAM_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# ---------------------------------------------------------------------
# Text-to-speech (TTS) provider
# One of: openai-tts | elevenlabs | azure | system
# ---------------------------------------------------------------------
VYRA_TTS_PROVIDER=openai-tts
ELEVENLABS_API_KEY=

# ---------------------------------------------------------------------
# Vision provider (screen understanding)
# Defaults to Google Gemini alongside the AI provider above.
# ---------------------------------------------------------------------
VYRA_VISION_PROVIDER=google
VYRA_VISION_MODEL=gemini-3-flash-preview

# ---------------------------------------------------------------------
# GitHub (used by VYRA's github_* tools, optional)
# Create a fine-grained personal access token with the repos you want
# VYRA to manage. VYRA never reads this from the renderer.
# ---------------------------------------------------------------------
GITHUB_TOKEN=

# ---------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------
# Directory for SQLite memory, logs and task persistence.
# Defaults to %APPDATA%/VYRA on Windows.
VYRA_DATA_DIR=
VYRA_LOG_LEVEL=info
# Push-to-talk hotkey (Electron accelerator format)
VYRA_PTT_HOTKEY=CommandOrControl+Shift+V
# Wake word (set VYRA_WAKE_WORD_ENABLED=true to enable listening)
VYRA_WAKE_WORD_ENABLED=false
VYRA_WAKE_WORD=hey vyra
